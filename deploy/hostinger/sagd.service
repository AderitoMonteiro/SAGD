[Unit]
Description=SAGD Django application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/sagd
EnvironmentFile=/var/www/sagd/.env
ExecStart=/var/www/sagd/.venv/bin/gunicorn --workers 3 --bind unix:/run/sagd.sock --umask 007 config.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
